# Copy to .env only on the deployment host. Do not commit .env.
SITE_ADDRESS=https://fashion.cora1022.com
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fashion.cora1022.com/api/members/login/oauth2/code/google
GOOGLE_FRONTEND_URL=https://fashion.cora1022.com
VITE_API_BASE_URL=
FASHIONCLIP_MODEL_NAME=patrickjohncyh/fashion-clip
FASHIONCLIP_MODEL_REVISION=7e3ba62ce16b379a1ab479346b66f192e76f51b7
FASHIONCLIP_VECTOR_SIZE=512
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=16000000
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=5
SEARCH_TIMEOUT_SECONDS=45
BACKEND_CPUS=2
BACKEND_MEMORY=4g
CORS_ORIGINS=https://fashion.cora1022.com
MYSQL_USER=stylefinder
MYSQL_PASSWORD=replace-with-a-strong-secret
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-secret
JWT_ISSUER=style-finder-member-service
JWT_AUDIENCE=style-finder-api
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_TOKEN_SECONDS=1209600
REFRESH_COOKIE_NAME=style_finder_refresh
REFRESH_COOKIE_PATH=/api/members
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_MAX_AGE_SECONDS=1209600
REFRESH_TOKEN_CLEANUP_INTERVAL_MS=3600000
REFRESH_TOKEN_REVOKED_RETENTION_HOURS=24
MEMBER_CORS_ORIGINS=https://fashion.cora1022.com
